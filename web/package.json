{
  "name": "portpilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000 --hostname 127.0.0.1",
    "gen:allowlist": "node scripts/gen-allowlist.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "node scripts/check.mjs",
    "gen:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.31",
    "@tanstack/react-query": "5.104.5",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eventsource-parser": "4.1.2",
    "lucide-react": "1.61.0",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.6",
    "orval": "8.44.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0"
  }
}
