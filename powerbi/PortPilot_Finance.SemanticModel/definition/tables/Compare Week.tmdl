/// finance.dim_week again, with no relationship: the second week of a comparison (approver-additions plan Phase G). Used only through the '(compare week)' measures (TREATAS onto Week); never filters a table by itself.
table 'Compare Week'
	lineageTag: d753cfa1-df18-4193-b237-91d8f8533a94

	column report_week
		dataType: int64
		formatString: 0
		lineageTag: 60f3c390-ca93-44f4-b626-3e9d86845048
		summarizeBy: none
		sourceColumn: report_week

	/// Pick the week to compare with the page's week.
	column iso_week_label
		dataType: string
		lineageTag: 32a73965-92a9-4baa-ae2d-839e9ec22fbe
		summarizeBy: none
		sourceColumn: iso_week_label
		sortByColumn: report_week

	partition 'Compare Week' = m
		mode: directQuery
		source =
				let
				  Source = PostgreSQL.Database("127.0.0.1:5432", "ports_logistics"),
				  #"Navigation 1" = Source{[Schema = "finance", Item = "dim_week"]}[Data]
				in
				  #"Navigation 1"

