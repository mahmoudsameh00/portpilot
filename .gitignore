# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Secrets: every .env file except the templates
.env
.env.*
!.env.example

# Editor settings (personal)
.vscode/
.idea/

# Temporary files and run logs
*.tmp
*.log
dev/_scratch/

# Raw downloads: never modified, never committed
Data/raw/

# Generated data that is rebuilt on demand
Data/processed/semi-structured/synthetic/*.parquet
# embedding vectors: only manifest.json is committed (its hashes prove a local dense.parquet matches, ADR-037)
Data/embeddings/*/dense*.parquet
Data/embeddings/*/cache_*/
Data/embeddings/bakeoff/
# local embedding model weights, rebuilt by dev/tools/export_onnx.py
models/
# uploaded documents waiting for a manager's promotion review
Data/incoming/
# model response cache + daily quota state, and the external tool cache (rebuilt by calling again)
Data/processed/agents/eval/llm_cache/
Data/processed/agents/tool_cache/
# weekly packs, voyage-watch runs and API logs written at run time
reports/

# Power BI: local user settings and the local data cache (the PBIP is the source, not a .pbix)
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
powerbi/*.pbix

# Deployment: store backups (dumps with password hashes) and one env file per environment (secrets);
# only deploy/env.example is tracked (ADR-071)
backups/
deploy/env/
