# One deployment environment of deploy/compose.yaml (ADR-071). Copy to deploy/env/<env>.env (git-ignored, mode 600)
# — or better, generate it: `python ops/deploy/new_env.py staging` writes fresh random passwords / keys for every
# store login and leaves the external API keys empty for you to fill. In Azure the file is rendered from Key Vault by
# ops/deploy/render_env.sh. Never reuse the owner's local .env values (ROADMAP: the old password is in git history).

# --- identity of the stack
PORTPILOT_ENV=staging                 # staging | production
PORTPILOT_STACK=portpilot-staging     # container / volume prefix (Backup.py --stack uses it)
PORTPILOT_TAG=local                   # the image tag deploy.sh builds (a git ref)

# --- public entry (Caddy)
PORTPILOT_SITE=staging.example.com    # the host name Caddy serves; `localhost` for the local rehearsal
PORTPILOT_WEB_ORIGIN=https://staging.example.com   # exactly what the browser shows (scheme, host, port if any)
CADDY_TLS=owner@example.com           # an email = Let's Encrypt; `internal` = Caddy's own CA (rehearsal)
PROXY_HTTP_BIND=80                    # host side of the published ports; rehearsal: 127.0.0.1:8080 / 127.0.0.1:8443
PROXY_HTTPS_BIND=443
QDRANT_HOST_PORT=6333                 # Qdrant on the host's loopback (Backup.py); rehearsal: 16333
QDRANT_HOST_URL=http://127.0.0.1:6333

# --- PostgreSQL: the owner account (only the postgres container and the `ops` service see it) + runtime logins
PGUSER=postgres
PGPASSWORD=
PG_RO_USER=
PG_RO_PASSWORD=
PG_BI_USER=
PG_BI_PASSWORD=
PG_AGENT_USER=
PG_AGENT_PASSWORD=
PG_API_USER=
PG_API_PASSWORD=
PG_AGENT_POOL_MAX=
PG_RO_POOL_MAX=
PG_API_POOL_MAX=

# --- MongoDB: root (the mongo container, Backup.py) + the app user (the loader only) + the tools' reader
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
MONGO_RO_USER=
MONGO_RO_PASSWORD=

# --- Qdrant
QDRANT_API_KEY=

# --- external APIs (free tiers, ADR-045 / S3); empty = that provider / tool is off
GEMINI_API_KEY=
GEMINI_TIER=paid
JINA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# --- scheduled identities (a Finance manager, an Operations manager; checked at every firing)
PACK_RUN_AS=
WATCH_RUN_AS=

# --- observability
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=                   # empty = PORTPILOT_ENV
